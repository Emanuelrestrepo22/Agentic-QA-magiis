# ============================================================================
# KATA Architecture - Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!
# Note: Bun loads .env automatically — no dotenv needed.
#
# Variables are validated at startup by validateEnv.ts.
# Only variables for current TEST_ENV are required.
# ============================================================================


# ============================================================================
# ENVIRONMENT SELECTION
# ============================================================================
# Which environment to test against
# Valid: local | staging
TEST_ENV=local


# ============================================================================
# TEST USER CREDENTIALS (Required per environment)
# ============================================================================
# Only credentials for your current TEST_ENV are validated.
# The other environment's credentials can be left empty.

# --- For TEST_ENV=local ---
LOCAL_USER_EMAIL=
LOCAL_USER_PASSWORD=

# --- For TEST_ENV=staging ---
STAGING_USER_EMAIL=
STAGING_USER_PASSWORD=


# ============================================================================
# BROWSER / RUNTIME (Optional overrides)
# ============================================================================
# HEADLESS=true
# DEFAULT_TIMEOUT=30000
# SCREENSHOT_ON_FAILURE=true
# VIDEO_ON_FAILURE=true
# ALLURE_RESULTS_DIR=./allure-results


# ----------------------------------------------------------------------------
#* AI AGENT MCP SERVERS — loading mechanics
# ----------------------------------------------------------------------------
# .mcp.json (Claude Code) and opencode.jsonc are committed to git and reference
# env vars via expansion:
#   - .mcp.json      → ${VAR_NAME} / ${VAR:-default}  (FAILS if missing)
#   - opencode.jsonc → {env:VAR_NAME}                 (empty string if missing)
#
# Two ways to load these vars before launching the agent:
#
#   A) Cross-platform wrapper (default, works on Windows/Mac/Linux):
#        bun run claude     → wraps `claude` with dotenv-cli
#        bun run opencode   → idem
#
#   B) Optional, Mac/Linux only: direnv auto-loads on `cd` into the repo.
#      See .envrc for the one-time setup. Once configured, run
#      `claude` / `opencode` directly — direnv exports .env into your shell.
# ----------------------------------------------------------------------------


# ============================================================================
# ATLASSIAN — single source of truth (DRY)
# ============================================================================
# One family of vars covers EVERY Atlassian consumer in this repo:
#   - acli CLI (skill .claude/skills/acli)
#   - xray-cli (skill .claude/skills/xray-cli)
#   - scripts/sync-jira-*.ts (raw REST calls)
#   - cli/doctor.ts auth loop
#   - Jira-Direct TMS provider (config/variables.ts → config.tms.jira)
#   - (opt-in) MCP atlassian server — see docs/mcp/ to enable it manually
#
# Naming rule:
#   - ATLASSIAN_*  = credentials
#   - JIRA_*       = operational (project key, output dir, custom field, etc.)
#
# Get an API token: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# --- Jira operational params (NOT credentials) ---
# Default project key for `bun run jira:sync-issues` (else .agents/project.yaml).
# JIRA_PROJECT_KEY=
# Output directory for synced issues (default: .context/PBI).
# JIRA_SYNC_OUTPUT=
# Default sprint selector for `pull --sprint` (active | current | closed | >=N | 7,8,10).
# Flag --sprint overrides this; this overrides the no-filter default.
# JIRA_SYNC_SPRINTS=
# Default csv of optional coverable work-type slugs added to `pull` (e.g. improvement,tech-story,tech-debt).
# Flag --types overrides this; this overrides the default scope (Epics + Stories + Bugs).
# JIRA_SYNC_TYPES=
# Jira-Direct TMS provider — custom field for run status:
# JIRA_TEST_STATUS_FIELD=customfield_10100


# ============================================================================
# TMS — Xray Cloud (Optional, also CI secrets)
# ============================================================================
# TMS_PROVIDER=xray
#
# The four vars below are active CI secrets referenced by .github/workflows/
# regression.yml (lines 45-47). They are pushed to GitHub Actions by
# `bun run setup --variables` and read back here for local runs. Leave them
# empty unless you actually use Xray sync — they are only required when
# TMS_PROVIDER=xray AND AUTO_SYNC=true.

# Operational flag — set true to auto-sync results to Xray in CI.
AUTO_SYNC=false
# Xray Cloud API credentials (https://app.getxray.app → API Keys).
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
# Xray project key to sync against — the project that holds the Xray ENTITIES, which is not
# necessarily the product project (see `testing.tms_project_key` in .agents/project.yaml).
# Must match the project prefix of your @atc ids: tests/utils/jiraSync.ts aborts the import on a
# mismatch instead of crediting results to the wrong project. A stale value here once created 32
# issues in the wrong project, so re-check it after any Jira project migration.
XRAY_PROJECT_KEY=


# ============================================================================
# SEARCH / DOCS MCPs
# ============================================================================
# Tavily — web search MCP — https://app.tavily.com/
TAVILY_API_KEY=


# ============================================================================
# API EXPLORATION & TESTING
# ============================================================================
# OpenAPI MCP — SCHEMA-READ-ONLY endpoint/contract discovery (list-api-endpoints,
# get-api-endpoint-schema). It does NOT execute authenticated requests — those
# run via curl (see the api:login token flow below).
#   API_BASE_URL       Base URL the agent uses for curl execution (the backend
#                      under test). Also the MCP's request base.
#   OPENAPI_SPEC_PATH  Where the MCP reads the schema: a local file (e.g.
#                      ./api/openapi.json, synced by `bun run api:sync`) OR a
#                      live URL (e.g. http://localhost:3000/api/openapi). The
#                      schema is typically dev/latest — keep that in mind when
#                      the target env (e.g. staging) lags behind dev.
API_BASE_URL=
OPENAPI_SPEC_PATH=

# Agentic API-testing token (curl flow):
#   `bun run api:login [env] [--role <role>]` authenticates and writes the token
#   to .auth/tokens.env (sourceable: export API_TOKEN_<ROLE>_<ENV>='<token>') and
#   .auth/tokens.json (metadata). Both are gitignored. Execute requests with:
#     source .auth/tokens.env && \
#     curl -H "Authorization: Bearer $API_TOKEN_<ROLE>_<ENV>" "$API_BASE_URL/<path>"
#   No restart is needed (the token never enters an MCP).
#
# API_TOKEN below is LEGACY and unused — the token is no longer written here and
# the OpenAPI MCP no longer reads it. Left for backward compatibility only.
API_TOKEN=

# Postman MCP — collection runner
# Get key: https://postman.com → workspace → API keys
POSTMAN_API_KEY=


# ============================================================================
# RESEND — Email-based test verification (Optional)
# ============================================================================
# Get a key: https://resend.com/api-keys
# Docs: https://resend.com/docs/api-reference/introduction
# Used for email-flow tests (signup confirmation, password reset, magic links).
# Also authenticates the `resend` CLI (CLI alt: `resend login` via browser).
RESEND_API_KEY=


# ============================================================================
# APPIUM MCP — Mobile Driver + Passenger automation (Optional)
# ============================================================================
# Required only when an Appium MCP server is enabled in .mcp.json
# ("appium-mcp-driver" and/or "appium-mcp-passenger"). All paths below are
# ABSOLUTE paths on the machine running the agent — machine-specific by nature.
#
# ⚠ .env alone is NOT enough. Claude Code substitutes ${VAR} in .mcp.json
# against the OS/session environment, NOT against this .env file — this repo's
# .env is never loaded into the process that parses .mcp.json. Confirmed
# 2026-08-14: a value present here since the day before still resolved empty
# and broke ADB init, because the OS-level env var was unset. Every var below
# MUST ALSO be set as a real environment variable at the OS level, e.g. on
# Windows (persists across restarts, matches how ANDROID_HOME is already set
# on this machine):
#   setx APPIUM_ANDROID_HOME "C:\path\to\Android\Sdk"
#   setx APPIUM_CAPABILITIES_CONFIG "C:\path\to\appium-mcp.driver.capabilities.json"
#   setx APPIUM_SCREENSHOTS_DIR "C:\path\to\evidence\appium-mcp\driver"
#   setx APPIUM_PASSENGER_CAPABILITIES_CONFIG "C:\path\to\appium-mcp.passenger.capabilities.json"
#   setx APPIUM_PASSENGER_SCREENSHOTS_DIR "C:\path\to\evidence\appium-mcp\passenger"
# On macOS/Linux, export them from your shell profile instead. Either way,
# changing these ALWAYS requires an agent-session RESTART — the env is cached
# once when the MCP server process is spawned and never re-read mid-session.
# Full doctrine + gotcha writeup: docs/testing/mobile-appium-mcp.md.
#
# APPIUM_ANDROID_HOME                     Android SDK root (holds platform-tools/).
#                                          Shared by both the driver and
#                                          passenger MCP servers — one SDK, two apps.
# APPIUM_CAPABILITIES_CONFIG              Capabilities JSON for the DRIVER session.
# APPIUM_SCREENSHOTS_DIR                  Screenshot dir for the DRIVER session.
# APPIUM_PASSENGER_CAPABILITIES_CONFIG    Capabilities JSON for the PASSENGER session.
# APPIUM_PASSENGER_SCREENSHOTS_DIR        Screenshot dir for the PASSENGER session.
#
# APPIUM_MCP_NO_UI            OPTIONAL, default `true`. Read by the mobile repo's
#                             config generator, NOT by .mcp.json (which carries the
#                             literal value). Beware the inversion: `false` ENABLES
#                             the server's HTML UI components. Leave it unset unless
#                             you specifically want the UI back.
#
# All capabilities files are generated, not hand-written — run
# `pnpm appium:mcp:driver:config` / `pnpm appium:mcp:passenger:config` from the
# mobile automation repo (a sibling checkout) after connecting the device.
# Claude Code FAILS TO PARSE .mcp.json when a ${VAR} it references is unset —
# leave the whole block out of .mcp.json (both entries) if you are not doing
# mobile work.
APPIUM_ANDROID_HOME=
APPIUM_CAPABILITIES_CONFIG=
APPIUM_SCREENSHOTS_DIR=
APPIUM_PASSENGER_CAPABILITIES_CONFIG=
APPIUM_PASSENGER_SCREENSHOTS_DIR=


# ============================================================================
# REMOTE DATABASE MCP — the [DB_TOOL] when the target DB is Oracle
# ============================================================================
# DBHub (below) does NOT support Oracle: its own config accepts only
# sqlserver | postgres | mysql | sqlite | mariadb. Projects on Oracle therefore
# resolve [DB_TOOL] to a remote database MCP instead.
#
# MAGIIS_DB_MCP_URL — HTTPS endpoint of the remote DB MCP (.mcp.json →
# "magiis-db"). The endpoint owns the credentials and enforces read-only, so no
# DB user/password belongs in this file.
#
# AUTH: this endpoint authenticates interactively. After setting the URL, run
# `/mcp` in an interactive session (or authorize the connector in claude.ai) and
# COMPLETE the flow — an unfinished authorization surfaces as "You started
# connecting but didn't finish" and every tool call fails. Auth cannot be
# completed in a headless/cron run.
#
# NOTE for automated specs: an MCP is an AGENT-time tool. A Playwright spec runs
# in a Node process with no MCP client, so it CANNOT query through this server.
# Specs that assert database state need an in-process driver (e.g. `oracledb`
# behind a read-only wrapper) — the MCP is not a substitute for that.
MAGIIS_DB_MCP_URL=

# ============================================================================
# DBHUB MCP — DATABASE CONNECTION (Optional, manual setup)
# ============================================================================
# NOT managed by the installer or `bun run doctor` — you must edit `dbhub.toml`
# yourself based on the target project's database. The installer cannot know
# which DB (sqlserver/postgres/mysql/sqlite/mariadb) your project uses.
# Does NOT support Oracle — see MAGIIS_DB_MCP_URL above for that case.
#
# Required only when the DBHub MCP server is enabled (.mcp.json → "dbhub").
# These vars are interpolated into the tracked file `dbhub.toml` at the repo
# root (the file uses `${VAR}` placeholders — safe to commit, no secrets in
# the TOML itself).
#
# IMPORTANT CAVEAT: DBHub silently substitutes the literal string `${VAR}`
# when a variable is missing from the process environment. This produces a
# cryptic auth failure (not a startup error). Verify all DBHUB_* vars below
# are exported BEFORE launching the MCP server: `env | grep DBHUB`.
#
# Add additional [[sources]] blocks in dbhub.toml if you need more databases.
DBHUB_TYPE=          # sqlserver | postgres | mysql | sqlite | mariadb
DBHUB_HOST=
DBHUB_PORT=          # 1433 (sqlserver) | 5432 (postgres) | 3306 (mysql/mariadb)
DBHUB_DATABASE=
DBHUB_USER=
DBHUB_PASSWORD=


# ============================================================================
# CI-ONLY SECRETS (set in GitHub Actions, NOT needed for local runs)
# ============================================================================
# Pushed to GitHub Actions by `bun run setup --variables`. Optional; only the
# CI workflows consume them, so they stay commented in your local .env.
#
# Slack incoming webhook for CI test-result notifications.
# SLACK_WEBHOOK_URL=


# ----------------------------------------------------------------------------
# CI/CD VARIABLES (set automatically by the runner, NOT here)
# ----------------------------------------------------------------------------
# CI=true          (set by GitHub Actions)
# BUILD_ID=<id>    (set by GitHub Actions)
# ----------------------------------------------------------------------------
